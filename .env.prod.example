# stats-hunter — prod/test окружение (Yandex Cloud VM).
# Скопировать в `.env` и подставить реальные значения.

# --- PostgreSQL (контейнер, хост-порт 5433) ---
POSTGRES_USER=stats_hunter
POSTGRES_PASSWORD=stats_hunter_dev
POSTGRES_DB=stats_hunter
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# --- Backend (NestJS) ---
DATABASE_URL=postgresql://stats_hunter:stats_hunter_dev@localhost:5433/stats_hunter
# Мастер-ключ шифрования ключей площадок: openssl rand -base64 32
STATS_HUNTER_ENCRYPTION_KEY=
PORT=3000
CORS_ORIGIN=http://158.160.204.124:8081

# Keycloak для бэкенда (админ API + валидация JWT)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=stats-hunter
# issuer в токене должен совпадать с тем, как браузер ходит в Keycloak
KEYCLOAK_ISSUER=http://158.160.204.124:8080/realms/stats-hunter
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/stats-hunter/protocol/openid-connect/certs

# --- Ozon (Seller API) ---
OZON_CLIENT_ID=
OZON_API_KEY=
