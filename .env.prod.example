# app-template — production окружение (пример).
# Скопируйте в `.env` и подставьте реальные значения (особенно секреты).

# --- PostgreSQL (контейнер, host-порт 5433) ---
POSTGRES_USER=app_template
POSTGRES_PASSWORD=app_template_dev
POSTGRES_DB=app_template
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# --- Backend (NestJS) ---
DATABASE_URL=postgresql://app_template:app_template_dev@localhost:5433/app_template
# Мастер-ключ шифрования: openssl rand -base64 32
APP_ENCRYPTION_KEY=
PORT=3000
APP_NAME=App Template
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com

# Keycloak для бэкенда (админ API + валидация JWT)
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=app-template
KEYCLOAK_CLIENT_ID=app-template-frontend
# issuer в токене должен совпадать с тем, как браузер ходит в Keycloak
KEYCLOAK_ISSUER=https://auth.example.com/realms/app-template
KEYCLOAK_JWKS_URI=https://auth.example.com/realms/app-template/protocol/openid-connect/certs

# SMTP-отправка писем (сброс пароля, подтверждение email)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAILER_FROM=App Template <no-reply@localhost>
