# stats-hunter — локальное окружение разработки.
# Скопируйте в `.env` и подставьте реальные значения (особенно секреты).

# --- PostgreSQL ---
POSTGRES_USER=stats_hunter
POSTGRES_PASSWORD=stats_hunter_dev
POSTGRES_DB=stats_hunter
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak ---
# Бэкенд (NestJS) читает эти переменные; фронтенд — из apps/frontend/src/environments/*.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# Админ-API Keycloak (используется при регистрации через бэкенд)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=stats-hunter
# Валидация JWT на бэкенде
KEYCLOAK_ISSUER=http://localhost:8080/realms/stats-hunter
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/stats-hunter/protocol/openid-connect/certs

# --- Frontend (Angular environments, не .env) ---
# Keycloak URL и client id фронта задаются в:
#   apps/frontend/src/environments/environment.ts      (dev)
#   apps/frontend/src/environments/environment.prod.ts (production, через fileReplacements)

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://stats_hunter:stats_hunter_dev@localhost:5433/stats_hunter

# --- Backend secrets ---
# Мастер-ключ для шифрования API-ключей площадок (AES-256-GCM).
# Сгенерировать: openssl rand -base64 32
STATS_HUNTER_ENCRYPTION_KEY=

# --- Ozon (Seller API) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- Backend ---
PORT=3000
# Разрешённые origin для CORS (через запятую). Пусто = запретить cross-origin.
# В prod — только реальный домен фронта. Пример: https://app.stats-hunter.ru
CORS_ORIGIN=http://localhost:4200
# Rate limiting публичных auth-эндпоинтов (окно и лимит запросов на IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# --- Восстановление пароля / письма ---
# Публичный адрес фронтенда — используется для ссылки в письме сброса пароля.
FRONTEND_URL=http://localhost:4200
# Время жизни reset-токена в миллисекундах (по умолчанию 30 минут).
RESET_TOKEN_TTL_MS=1800000

# SMTP-отправка (приоритет 1). Например Яндекс: smtp.yandex.ru:465 + пароль приложения.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Webhook транзакционного email-провайдера (приоритет 2, принимает {from,to,subject,text,html}).
# Если не задан ни SMTP, ни webhook — ссылка сброса логируется в консоль бэкенда (dev-режим).
MAILER_WEBHOOK_URL=
# Отправитель письма. Для Яндекс SMTP должен совпадать с SMTP_USER; по умолчанию берётся SMTP_USER.
MAILER_FROM=Stats Hunter <no-reply@stats-hunter.local>
